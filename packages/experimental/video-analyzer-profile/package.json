{
  "name": "@deepseek-ai/dsh-experimental-video-analyzer-profile",
  "description": "Dedicated video transcription, segmentation, and analysis module powered by local ASR",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src/scripts/*"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-experimental-module-scheduler": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
