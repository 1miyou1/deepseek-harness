{
  "name": "@deepseek-ai/dsh-experimental-module-scheduler-web-profile",
  "description": "Private Web profile layer for the experimental module scheduler console",
  "version": "0.1.2-alpha.5",
  "private": true,
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/experimental/module-scheduler-web-profile" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
