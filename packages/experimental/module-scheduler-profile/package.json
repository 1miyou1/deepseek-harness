    "./cordis.developer.patch.yml": "./cordis.developer.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "cordis.patch.yml", "cordis.validator.patch.yml", "cordis.organizer.patch.yml", "cordis.developer.patch.yml", "lib/types/**/*.js", "lib/types/**/*.d.ts"],
