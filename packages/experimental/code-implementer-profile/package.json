{
  "name": "@deepseek-ai/dsh-experimental-code-implementer-profile",
  "description": "Dedicated code implementation and scoped patcher module with atomic file updates and strict write boundary protection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-experimental-module-scheduler": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
